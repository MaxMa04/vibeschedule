{
  "name": "vibeschedule",
  "version": "0.1.0",
  "description": "Internal CLI for uploading and scheduling TikTok posts via Cloudflare R2 and Post for Me.",
  "type": "module",
  "bin": {
    "vibeschedule": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "better-sqlite3": "^11.9.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "js-yaml": "^4.1.0",
    "luxon": "^3.6.1",
    "mime-types": "^2.1.35",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
