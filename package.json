{
  "name": "vibeschedule",
  "version": "1.0.0",
  "description": "Internes Social-Media-Scheduling für VibeLabs",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "pnpm run --filter ./apps/backend --filter ./apps/frontend --parallel dev",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "rm -rf apps/backend/dist && pnpm --filter ./apps/backend run build",
    "build:frontend": "pnpm --filter ./apps/frontend run build",
    "build:cli": "pnpm --filter ./apps/cli run build",
    "start:backend": "pnpm --filter ./apps/backend run start",
    "start:frontend": "pnpm --filter ./apps/frontend run start",
    "typecheck": "tsc -p apps/backend/tsconfig.json --noEmit && tsc -p apps/frontend/tsconfig.json --noEmit && tsc -p apps/cli/tsconfig.json --noEmit",
    "dev:docker": "docker compose -f ./docker-compose.dev.yaml up -d",
    "prisma-generate": "prisma generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "prisma-db-push": "prisma db push --skip-generate --schema ./libraries/nestjs-libraries/src/database/prisma/schema.prisma",
    "postinstall": "pnpm run prisma-generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
