# Postgres, docker-compose.dev.yaml starts one for local development
DATABASE_URL="postgresql://vibeschedule:vibeschedule@localhost:5432/vibeschedule"
JWT_SECRET="a long random string"

# URLs the app is reached on
FRONTEND_URL="http://localhost:4200"
MAIN_URL="http://localhost:4200"
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"
BACKEND_INTERNAL_URL="http://localhost:3000"
# https URL of the API as seen from the internet, used for the Post for Me
# webhook. Leave empty locally, the calendar then asks Post for Me for results.
BACKEND_PUBLIC_URL=""
# Local http only: plain cookies and the auth token in a header
NOT_SECURED="true"

# Post for Me, the social layer
POST_FOR_ME_API_KEY=""
#POST_FOR_ME_BASE_URL="https://api.postforme.dev/v1"

# Cloudflare R2, the media storage. Post for Me loads the media from the
# public bucket URL.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME="vibeschedule-media"
CLOUDFLARE_BUCKET_URL="https://vibeschedule-media.vibelabs.to"
CLOUDFLARE_REGION="auto"

# First start without users: creates the workspace and this admin
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
