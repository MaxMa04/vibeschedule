generator client {
  provider = "prisma-client-js"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  apiKey              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  apps                App[]
  formats             Format[]
  integrations        Integration[]
  media               Media[]
  posts               Post[]
  tags                Tags[]
  users               UserOrganization[]
  clipperApplications ClipperApplication[]
  clipperAccounts     ClipperAccount[]
  clipperTasks        ClipperTask[]

  @@index([apiKey])
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  name            String?
  /// WhatsApp number, from a clipper application
  phone           String?
  timezoneName    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  organizations   UserOrganization[]
  channels        UserIntegration[]
  clipperAccounts ClipperAccount[]
}

model UserOrganization {
  id              String       @id @default(uuid())
  userId          String
  organizationId  String
  role            Role         @default(USER)
  /// how many TikTok accounts a clipper runs for us, connecting more is blocked
  clipperAccounts Int          @default(3)
  /// where a clipper's pay goes, entered by the clipper during the onboarding
  payoutName      String?
  payoutIban      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Tags {
  id           String       @id @default(uuid())
  name         String
  color        String
  orgId        String
  deletedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  posts        TagsPosts[]

  @@index([orgId])
  @@index([deletedAt])
}

model TagsPosts {
  postId    String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id])
  tag       Tags     @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model Media {
  id             String       @id @default(uuid())
  name           String
  originalName   String?
  path           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

/// An app of VibeLabs (UBulk, Amelie, ...). Channels belong to at most one app.
/// Stored in the former Postiz "Customer" table.
model App {
  id           String        @id @default(uuid())
  name         String
  orgId        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  organization Organization  @relation(fields: [orgId], references: [id])
  integrations Integration[]

  @@unique([orgId, name, deletedAt])
  @@map("Customer")
}

/// A content format (e.g. "Lockscreen-Story"). Runs on channels via
/// IntegrationFormat; a post can name the format it belongs to.
model Format {
  id           String              @id @default(cuid())
  orgId        String
  name         String
  description  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  organization Organization        @relation(fields: [orgId], references: [id])
  integrations IntegrationFormat[]
  posts        Post[]
  feedPosts    FeedPostFormat[]

  @@index([orgId])
}

/// A format running on a channel.
model IntegrationFormat {
  integrationId String
  formatId      String
  status        FormatStatus @default(ACTIVE)
  note          String?
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  integration   Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  format        Format       @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@id([integrationId, formatId])
  @@index([formatId])
}

/// The format of a post that was published without vibeschedule (posted by
/// hand) and only shows up in the channel's PfM feed. Never a Post: it has
/// no date in the calendar, no clipper pay and nothing to publish.
model FeedPostFormat {
  integrationId  String
  /// platform_post_id from the PfM feed (TikTok video id, YouTube video id …)
  platformPostId String
  formatId       String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  integration    Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  format         Format      @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@id([integrationId, platformPostId])
  @@index([formatId])
}

/// A Post for Me social account. internalId is the PfM account id (spc_...),
/// providerIdentifier the PfM platform.
model Integration {
  id                 String              @id @default(cuid())
  internalId         String
  organizationId     String
  name               String
  customName         String?
  picture            String?
  profile            String?
  providerIdentifier String
  disabled           Boolean             @default(false)
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime?           @updatedAt
  postingTimes       String              @default("[{\"time\":120}, {\"time\":400}, {\"time\":700}]")
  appId              String?             @map("customerId")
  additionalSettings String?             @default("[]")
  /// nothing of this channel ever goes to PfM, people post it themselves
  manualOnly         Boolean             @default(false)
  /// what a clipper earns for this account per month, in cents; null: not paid
  clipFeeCents       Int?
  /// posts a clipper owes per day on this account
  clipPostsPerDay    Int                 @default(1)
  app                App?                @relation(fields: [appId], references: [id])
  organization       Organization        @relation(fields: [organizationId], references: [id])
  posts              Post[]
  formats            IntegrationFormat[]
  feedFormats        FeedPostFormat[]
  users              UserIntegration[]
  clipperAccount     ClipperAccount?

  @@unique([organizationId, internalId])
  @@index([organizationId])
  @@index([deletedAt])
  @@index([appId])
}

/// Who is responsible for which channel. A clipper sees and posts only these.
model UserIntegration {
  userId        String
  integrationId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([userId, integrationId])
  @@index([integrationId])
}

/// Someone who applied on the public page /clipping. Accepting creates the
/// clipper login from it (with the password chosen here).
model ClipperApplication {
  id           String            @id @default(cuid())
  orgId        String
  status       ApplicationStatus @default(PENDING)
  name         String
  email        String
  /// WhatsApp number
  phone        String
  age          Int
  /// iphone or android
  device       String
  /// how many accounts they want to run
  accounts     Int
  experience   String?
  source       String?
  /// bcrypt hash, becomes the login password on acceptance
  password     String
  /// the clipper login created on acceptance
  userId       String?
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  organization Organization      @relation(fields: [orgId], references: [id])

  @@index([orgId, status])
  @@index([email])
}

/// One TikTok account a clipper runs for us: the profile we hand out (picture,
/// name, username, niche) and how far the clipper got with creating and warming
/// it up (rules in libraries/helpers/src/clippers/clipper.onboarding.ts).
model ClipperAccount {
  id            String        @id @default(cuid())
  orgId         String
  userId        String
  /// 0, 1, 2 … the order the clipper creates the accounts in
  position      Int
  name          String?
  username      String?
  bio           String?
  /// public R2 URL of the profile picture
  avatar        String?
  /// the niche the account warms up in, e.g. "Zunehmen / Gym"
  topic         String?
  /// search terms for the warm-up, one per line
  searchTerms   String?
  /// when the clipper created the account in TikTok
  createdOn     DateTime?
  /// one entry per warm-up day the clipper checked off
  warmups       DateTime[]
  /// the For You page shows the niche after the warm-up
  fypOkAt       DateTime?
  /// the vibeschedule channel once the account is connected
  integrationId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  organization  Organization  @relation(fields: [orgId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  integration   Integration?  @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  tasks         ClipperTask[]

  @@unique([userId, position])
  @@index([orgId])
}

/// Something the clipper still has to do on one account, also while it is
/// running, e.g. switching it to a new profile. The clipper checks it off on
/// the posting page (rules in libraries/helpers/src/clippers/clipper.tasks.ts).
model ClipperTask {
  id           String          @id @default(cuid())
  orgId        String
  accountId    String
  /// PROFILE shows the handed-out profile (picture, name, username, bio)
  kind         ClipperTaskKind @default(CUSTOM)
  title        String
  description  String?
  doneAt       DateTime?
  doneById     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  organization Organization    @relation(fields: [orgId], references: [id])
  account      ClipperAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([orgId])
}

enum ClipperTaskKind {
  CUSTOM
  PROFILE
}

/// One row per channel. Posts saved together for several channels share a batchId.
model Post {
  id             String         @id @default(cuid())
  state          State          @default(QUEUE)
  publishDate    DateTime
  organizationId String
  integrationId  String
  content        String
  group          String
  batchId        String?
  settings       String?
  image          String?
  pfmPostId      String?
  releaseId      String?
  releaseURL     String?
  error          String?
  formatId       String?
  creationMethod CreationMethod @default(WEB)
  /// posted by hand in the app instead of through PfM
  manual         Boolean        @default(false)
  /// when and by whom a manual post was marked as posted
  postedAt       DateTime?
  postedById     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  integration    Integration    @relation(fields: [integrationId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  format         Format?        @relation(fields: [formatId], references: [id])
  tags           TagsPosts[]

  @@index([group])
  @@index([batchId])
  @@index([deletedAt])
  @@index([state])
  @@index([pfmPostId])
  @@index([integrationId])
  @@index([formatId])
  @@index([organizationId, publishDate])
}

enum State {
  QUEUE
  PUBLISHED
  ERROR
  DRAFT
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum FormatStatus {
  ACTIVE
  TESTING
  PAUSED
}

enum Role {
  ADMIN
  USER
  /// external poster, limited to the channels in UserIntegration
  CLIPPER
}

enum CreationMethod {
  WEB
  API
  CLI
}
